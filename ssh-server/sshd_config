# Ultra-Secure SSH Configuration for WPlib Remote Development
# Only allows connections from 10.57.28.2 (robot)
# Uses maximum security hardening

# Network restrictions - ONLY accept from robot IP
ListenAddress 0.0.0.0
Port 2222

# Protocol version - SSH-2 only (SSH-1 is insecure)
Protocol 2

# Authentication - KEY ONLY, no passwords
PasswordAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
PubkeyAuthentication yes
AuthenticationMethods publickey

# Maximum security key algorithms only (using widely supported secure algorithms)
HostKeyAlgorithms ssh-ed25519
PubkeyAcceptedAlgorithms ssh-ed25519
KexAlgorithms curve25519-sha256,diffie-hellman-group-exchange-sha256
Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com

# Disable unnecessary features
X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no
GatewayPorts no
PermitUserEnvironment no
UsePAM no

# Restrict to single user
AllowUsers wplib-dev

# SFTP subsystem configuration
Subsystem sftp internal-sftp

# Match block for SFTP-only restriction to workspaces folder
Match User wplib-dev
    ForceCommand internal-sftp -d /home/wplib-dev/Jarvis/dev/workspaces
    ChrootDirectory /home/wplib-dev/Jarvis/dev/workspaces
    PermitTunnel no
    PermitUserRC no
    AllowAgentForwarding no
    AllowTcpForwarding no
    X11Forwarding no

# Session limits
MaxAuthTries 2
MaxSessions 1
LoginGraceTime 30
ClientAliveInterval 60
ClientAliveCountMax 2

# Logging
LogLevel VERBOSE
SyslogFacility AUTH

# Disable motd and other banners
PrintMotd no
PrintLastLog no

# Strict mode
StrictModes yes
IgnoreRhosts yes
HostbasedAuthentication no
