# ── MCHS Robotics API environment ────────────────────────────────────────────
# Copy this file to api/.env and fill in real values.
# NEVER commit .env — it holds secret keys (.gitignore already excludes it).

# Option A — Resend (https://resend.com, free tier needs no domain):
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B — any SMTP server (e.g. Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false

# Where application-review emails are sent (default: physicsiscool314@gmail.com)
# ADMIN_EMAIL=physicsiscool314@gmail.com

# Sender override (Resend free tier must use onboarding@resend.dev)
# EMAIL_FROM=MCHS Robotics Portal <onboarding@resend.dev>

# Base URL used for the Approve/Deny links inside emails.
# In production docker-compose.yml sets this to https://mchsrobotics.dev
# PUBLIC_URL=https://mchsrobotics.dev

# With no provider configured, emails (including approve/deny links) are
# printed to the server log so the flow remains testable locally.

# ── Push Notifications (Web Push API) ───────────────────────────────────────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
# These are used for web push notifications (board messages, meeting reminders)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@mchsrobotics.dev

# ── Google Sign-In (primary sign-in method — replaces custom accounts) ───────
# Create an OAuth 2.0 "Web application" Client ID at
# https://console.cloud.google.com/apis/credentials and add every origin you
# serve the site from to "Authorized JavaScript origins"
# (e.g. http://localhost:5173, http://localhost:3001, https://mchsrobotics.dev).
# There is NO redirect URI and NO client secret needed — we use the ID-token
# flow (Google Identity Services), verified server-side with google-auth-library.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Comma-separated email domains allowed to sign in (the replacement for the old
# join key). Empty/unset = any Google account may sign in — fine for local
# testing, SET THIS IN PRODUCTION.
GOOGLE_ALLOWED_DOMAINS=mcsd47.org

# Optional: exact emails always allowed even if their domain is blocked.
# GOOGLE_ALLOWLIST=coach.person@gmail.com

# Optional: emails that get admin rights on first sign-in (replaces the old
# hardcoded admin username list).
# ADMIN_EMAILS=you@mcsd47.org
