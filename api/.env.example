# ── MCHS Robotics API environment ────────────────────────────────────────────
# Copy this file to api/.env and fill in real values.
# NEVER commit .env — it holds secret keys (.gitignore already excludes it).

# Option A — Resend (https://resend.com, free tier needs no domain):
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option B — any SMTP server (e.g. Gmail with an app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false

# Where application-review emails are sent (default: physicsiscool314@gmail.com)
# ADMIN_EMAIL=physicsiscool314@gmail.com

# Sender override (Resend free tier must use onboarding@resend.dev)
# EMAIL_FROM=MCHS Robotics Portal <onboarding@resend.dev>

# Base URL used for the Approve/Deny links inside emails.
# In production docker-compose.yml sets this to https://mchsrobotics.dev
# PUBLIC_URL=https://mchsrobotics.dev

# With no provider configured, emails (including approve/deny links) are
# printed to the server log so the flow remains testable locally.

# ── Push Notifications (Web Push API) ───────────────────────────────────────────
# Generate VAPID keys with: npx web-push generate-vapid-keys
# These are used for web push notifications (board messages, meeting reminders)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@mchsrobotics.dev
